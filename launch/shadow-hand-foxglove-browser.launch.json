{
  "version": "0.1",
  "defaults": {
    "stdout": "logs/${asset}.out",
    "stderr": "logs/${asset}.err",
    "env": {
      "prepend": {
        "lib_path": [
          "${ENV:HAKONIWA_LIBPATH}"
        ],
        "PATH": [
          "${ENV:HAKONIWA_BINPATH}"
        ]
      }
    },
    "start_grace_sec": 1,
    "delay_sec": 1
  },
  "assets": [
    {
      "name": "shadow_hand",
      "activation_timing": "before_start",
      "command": "./src/cmake-build/examples/actuators/shadow_hand/shadow-hand-hakoniwa-asset",
      "args": [
      ],
      "cwd": "${MUJOCO_DIRPATH}",
      "delay_sec": 2
    },
    {
      "name": "shadow_hand_urdf_server",
      "activation_timing": "before_start",
      "command": "${PYTHON_CMD}",
      "args": [
        "tools/serve_static_cors.py",
        "--directory",
        "work/urdf/shadow_hand",
        "--port",
        "8767"
      ],
      "cwd": "${FOXGLOVE_DIRPATH}",
      "depends_on": [
        "shadow_hand"
      ]
    },
    {
      "name": "foxglove_jointstate_publisher",
      "activation_timing": "before_start",
      "command": "${PYTHON_CMD}",
      "args": [
        "examples/shadow-hand-jointstate-to-foxglove/shadow_hand_jointstate_to_foxglove.py",
        "--samples",
        "0"
      ],
      "cwd": "${FOXGLOVE_DIRPATH}",
      "depends_on": [
        "shadow_hand_urdf_server"
      ]
    },    
    {
      "name": "shadow_hand_bridge",
      "activation_timing": "before_start",
      "command": "./build/hakoniwa-pdu-web-bridge",
      "args": [
        "--config-root",
        "../hakoniwa-pdu-foxglove/config/shadow_hand_bridge",
        "--asset-name",
        "ShadowHandBridge",
        "--node-name",
        "shadow_hand_foxglove_bridge_node1",
        "--delta-time-step-usec",
        "20000"
      ],
      "cwd": "${BRIDGE_DIRPATH}",
      "depends_on": [
        "shadow_hand",
        "foxglove_jointstate_publisher"
        ],
      "delay_sec": 1
    },
    {
      "name": "shadow_hand_sender",
      "activation_timing": "before_start",
      "command": "${PYTHON_CMD}",
      "args": [
        "examples/actuators/shadow_hand/send_shadow_hand_targets.py",
        "--duration-sec",
        "120",
        "--frequency-hz",
        "0.25"
      ],
      "cwd": "${MUJOCO_DIRPATH}",
      "depends_on": [
        "shadow_hand_bridge"
      ],
      "delay_sec": 1
    }
  ]
}
